---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { localizedPath, siteNames, type Locale } from '../i18n';

interface Props { locale: Locale; canonicalPath?: string; }
const { locale, canonicalPath } = Astro.props;

const copy = {
  zh: {
    title: `${siteNames.zh}｜魔兽世界无限服，开局直接抄作业`,
    description: '魔兽世界无限服中英双语新手攻略：职业选择、1—60级练级、16点传承、专业营地搭配和开服准备清单。先看结论，再照着做。',
    eyebrow: 'WOW FOREVER · 玩家自制攻略',
    heroA: '开局别抓瞎。',
    heroB: '直接抄作业。',
    lead: '职业怎么选、升级先做什么、16点传承怎么点、营地带什么——把长篇研究压成能照着做的清单。',
    primary: '30秒选职业', secondary: '先看开服清单',
    countdown: '距离全球开服', days: '天', hours: '时', minutes: '分', live: '已经开服，进游戏吧',
    cap: '等级上限', access: '进入条件', principle: '攻略原则', gameTime: '有效游戏时间', answer: '先答案，后原理',
    stripTitle: '只记一件事', strip: '和朋友先选同一个规则集。不同规则集之间不能组队，别进游戏后才发现被迫分开。',
    stripLink: '看懂规则集',
    kicker: 'START HERE', sectionTitle: '现在最该看的', sectionLead: '不是资料仓库，是一份能执行的开服计划。', all: '全部开服准备',
    cards: [
      { slug: 'classes', icon: 'compass', title: '我该玩什么职业？', text: '按独狼、组队、职责和操作习惯筛选，不给你一张看不懂的强度榜。', link: '开始选择' },
      { slug: 'launch', icon: 'clock', title: '开服前准备清单', text: '开服时间、游戏时间、礼包区别、规则集，6项可打勾检查。', link: '逐项检查' },
      { slug: 'leveling', icon: 'route', title: '1—60级练级总览', text: '每阶段先做什么、哪些功能别漏，先看懂节奏再进游戏。', link: '规划路线' },
      { slug: 'legacy', icon: 'legacy', title: '16点传承怎么选', text: '不用被迫练小号。按练级、专业和独狼目标整理优先顺序。', link: '先看优先级' },
      { slug: 'camping', icon: 'campfire', title: '营地专业搭配器', text: '最多放3件，坐1分钟拿增益。选专业后自动生成队伍清单。', link: '开始搭配' },
      { slug: 'rulesets', icon: 'users', title: '规则集怎么选', text: '普通、PvP、角色扮演和硬核，一次讲清区别与组队限制。', link: '和朋友一起选' },
    ],
    processKicker: 'HOW IT WORKS', processTitle: '攻略只走三步', processLead: '把复杂留在我们这边，把简单留给你。',
    steps: [
      { title: '先选你的玩法', text: '独狼还是组队？喜欢坦克、治疗还是输出？每天能玩多久？' },
      { title: '再抄对应方案', text: '每篇先给结论和清单；想知道原因，再展开看原理与来源。' },
      { title: '最后进游戏核对', text: '正式服热修可能改变答案。我们标注版本，发现变化就更新。' },
    ],
    toolKicker: 'NO ACCOUNT NEEDED', toolTitle: '打开就能用，不用先注册', toolText: '职业选择和营地搭配都在浏览器里完成。生成结果可以复制给朋友，不收集游戏账号，也不要求下载插件。',
    toolPrimary: '试试职业选择器', toolSecondary: '搭配三人营地',
  },
  en: {
    title: `${siteNames.en} | WoW Forever guides you can actually use`,
    description: 'Practical WoW Forever guides in English and Chinese: class choices, level 1—60 planning, 16-point Legacy priorities, camping combos and launch preparation.',
    eyebrow: 'WOW FOREVER · PLAYER-MADE GUIDES',
    heroA: 'Stop researching.',
    heroB: 'Start playing.',
    lead: 'Which class, what to do first, how to spend 16 Legacy points, and what to bring to camp—long research turned into short, usable checklists.',
    primary: 'Find my class in 30s', secondary: 'Launch checklist',
    countdown: 'Until global launch', days: 'days', hours: 'hrs', minutes: 'min', live: 'Now live. See you in Azeroth!',
    cap: 'Level cap', access: 'Access', principle: 'Our rule', gameTime: 'Active game time', answer: 'Answer first, theory second',
    stripTitle: 'Remember one thing', strip: 'Choose the same ruleset as your friends. Players on different rulesets cannot group together.',
    stripLink: 'Compare rulesets',
    kicker: 'START HERE', sectionTitle: 'What to read right now', sectionLead: 'Not a data warehouse. A launch plan you can follow.', all: 'All launch prep',
    cards: [
      { slug: 'classes', icon: 'compass', title: 'Which class should I play?', text: 'Filter by solo or group play, preferred role and experience. No unexplained tier list.', link: 'Find your class' },
      { slug: 'launch', icon: 'clock', title: 'Launch preparation', text: 'Launch time, game time, optional packs and rulesets in six checkable steps.', link: 'Check the list' },
      { slug: 'leveling', icon: 'route', title: 'Level 1—60 overview', text: 'What matters at each stage and which systems not to miss along the way.', link: 'Plan the journey' },
      { slug: 'legacy', icon: 'legacy', title: 'Your first 16 Legacy points', text: 'No mandatory alt army. Priorities for leveling, professions and solo play.', link: 'See the priorities' },
      { slug: 'camping', icon: 'campfire', title: 'Camp combo builder', text: 'Up to three features and one minute for the benefits. Build and copy a group checklist.', link: 'Build a camp' },
      { slug: 'rulesets', icon: 'users', title: 'Choose a ruleset', text: 'Normal, PvP, roleplaying and Hardcore, including the grouping restrictions.', link: 'Choose with friends' },
    ],
    processKicker: 'HOW IT WORKS', processTitle: 'Three steps. No lore essay.', processLead: 'We keep the complexity here so you can get back to the game.',
    steps: [
      { title: 'Choose how you play', text: 'Solo or with friends? Tank, healer or damage? A little time or a lot?' },
      { title: 'Copy a matching plan', text: 'Every guide starts with an answer and a checklist. The reasoning and sources follow.' },
      { title: 'Verify it in game', text: 'Live hotfixes can change the answer. We label versions and update when they do.' },
    ],
    toolKicker: 'NO ACCOUNT NEEDED', toolTitle: 'Use it now. No sign-up wall.', toolText: 'The class finder and camp builder run in your browser. Copy the result for a friend. No game account, login or addon required.',
    toolPrimary: 'Try the class finder', toolSecondary: 'Build a three-player camp',
  },
}[locale];
const iconName = (name: string) => name as 'compass' | 'route' | 'legacy' | 'campfire' | 'clock' | 'users';
---
<BaseLayout locale={locale} title={copy.title} description={copy.description} canonicalPath={canonicalPath}>
  <section class="hero">
    <div class="container">
      <div class="hero-shell">
        <div class="hero-copy">
          <div class="eyebrow">{copy.eyebrow}</div>
          <h1>{copy.heroA}<br /><em>{copy.heroB}</em></h1>
          <p class="hero-lead">{copy.lead}</p>
          <div class="button-row">
            <a class="button button-primary" href={localizedPath(locale, 'classes')}>{copy.primary}<Icon name="arrow" size={18} /></a>
            <a class="button button-secondary" href={localizedPath(locale, 'launch')}>{copy.secondary}</a>
          </div>
        </div>
        <aside class="hero-side" aria-label={copy.countdown}>
          <div class="hero-side-header"><span>{copy.countdown}</span><span class="tag tag-white">UTC+8 · 07:00</span></div>
          <div id="countdown" data-locale={locale}>
            <div class="countdown" aria-live="polite">
              <div class="countdown-unit"><strong data-days>—</strong><span>{copy.days}</span></div>
              <div class="countdown-unit"><strong data-hours>—</strong><span>{copy.hours}</span></div>
              <div class="countdown-unit"><strong data-minutes>—</strong><span>{copy.minutes}</span></div>
            </div>
            <p class="small" data-live hidden style="color: var(--gold); font-weight: 800;">{copy.live}</p>
          </div>
          <div class="hero-facts">
            <div class="hero-fact"><span>{copy.cap}</span><strong>60</strong></div>
            <div class="hero-fact"><span>{copy.access}</span><strong>{copy.gameTime}</strong></div>
            <div class="hero-fact"><span>{copy.principle}</span><strong>{copy.answer}</strong></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="quick-strip">
      <strong>{copy.stripTitle}</strong>
      <p>{copy.strip}</p>
      <a class="text-link" href={localizedPath(locale, 'rulesets')}>{copy.stripLink}<Icon name="arrow" size={16} /></a>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div><div class="section-kicker">{copy.kicker}</div><h2>{copy.sectionTitle}</h2><p>{copy.sectionLead}</p></div>
        <a class="text-link" href={localizedPath(locale, 'launch')}>{copy.all}<Icon name="arrow" size={17} /></a>
      </div>
      <div class="card-grid">
        {copy.cards.map((card, index) => (
          <a class="card guide-card" href={localizedPath(locale, card.slug)}>
            <div class={`icon-box ${index % 3 === 1 ? 'orange' : ''}`}><Icon name={iconName(card.icon)} size={23} /></div>
            <span class="card-number">0{index + 1}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            <span class="card-link">{card.link}<Icon name="arrow" size={17} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header"><div><div class="section-kicker">{copy.processKicker}</div><h2>{copy.processTitle}</h2><p>{copy.processLead}</p></div></div>
      <div class="step-grid">
        {copy.steps.map((step, index) => <div class="step-card"><span class="step-number">{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="hero-shell tool-banner">
        <div>
          <div class="eyebrow">{copy.toolKicker}</div>
          <h2 style="font-size: clamp(27px, 3.5vw, 40px); line-height: 1.25; margin-bottom: 12px; letter-spacing: -.035em;">{copy.toolTitle}</h2>
          <p style="color: #c7d6ce; max-width: 650px;">{copy.toolText}</p>
        </div>
        <div class="button-row" style="justify-content: flex-end;">
          <a class="button button-primary" href={localizedPath(locale, 'classes')}>{copy.toolPrimary}<Icon name="arrow" size={17} /></a>
          <a class="button button-secondary" href={localizedPath(locale, 'camping')}>{copy.toolSecondary}</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const countdown = document.querySelector<HTMLElement>('#countdown');
    if (countdown) {
      const launch = new Date('2026-11-04T23:00:00Z').getTime();
      const daysNode = countdown.querySelector<HTMLElement>('[data-days]');
      const hoursNode = countdown.querySelector<HTMLElement>('[data-hours]');
      const minutesNode = countdown.querySelector<HTMLElement>('[data-minutes]');
      const updateCountdown = () => {
        const remaining = Math.max(0, launch - Date.now());
        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        if (daysNode) daysNode.textContent = String(days).padStart(2, '0');
        if (hoursNode) hoursNode.textContent = String(hours).padStart(2, '0');
        if (minutesNode) minutesNode.textContent = String(minutes).padStart(2, '0');
        if (remaining === 0) {
          countdown.querySelector('.countdown')?.setAttribute('hidden', '');
          countdown.querySelector('[data-live]')?.removeAttribute('hidden');
        }
      };
      updateCountdown();
      window.setInterval(updateCountdown, 60000);
    }
  </script>
</BaseLayout>
