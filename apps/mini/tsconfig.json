{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vite/client", "@dcloudio/types"],
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../../src/data/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue", "vite.config.ts"]
}
